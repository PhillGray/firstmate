# FirstMate Relay Connector
FMX_PAIRING_TOKEN=your_fmx_pairing_token_here

# Worker harness and GitHub CLI provider keys - firstmate reads none of these
# from this file, and .env is not forwarded to a worker's environment; the
# harness and gh CLIs read them from the ambient environment
# (docs/configuration.md "Worker launch environment"). Listed here only as this
# home's credential checklist.
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
GITHUB_TOKEN=your_github_token_here

# Typesafe.ai System One (Jev) - opt-in typed crew dispatch resolution (bin/fm-dispatch-resolve.sh)
TYPESAFE_API_KEY=your_typesafe_api_key_here
